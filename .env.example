DATABASE_URL=postgres://turnwise:turnwise@localhost:5433/turnwise
REDIS_URL=redis://localhost:6380
PORT=4100
# Signs staff session cookies. Required when NODE_ENV=production; generate with `openssl rand -base64 32`
SESSION_SECRET=
SESSION_HOURS=12
# Simulated failure rate for notification delivery (0..1) to exercise retries
NOTIFY_FAILURE_RATE=0.15
# Enables /api/sim/* endpoints used by the demo scenario panel
ENABLE_SIMULATOR=true
# Synthetic centres, staff, catalogue and demand loaded by `npm run seed` (path relative to server/)
SEED_FIXTURE=fixtures/demo.json

# Single-service hosting (see render.yaml). Off by default; locally the API and
# worker run as separate processes and you migrate and seed by hand.
# Run the BullMQ worker inside the API process
RUN_WORKER_IN_API=false
# Apply pending migrations before the API starts listening
MIGRATE_ON_START=false
# Seed on start and every 10 minutes when there are no centres, the demo day is
# from an earlier date, or the default centre is closed. Wipes all centres: demo only.
DEMO_AUTO_REFRESH=false
# Express "trust proxy": hops in front of the app (1 on Render), true, or loopback
TRUST_PROXY=loopback

# Operational tuning (overrun grace, slot spacing, flags, simulator rates...) is
# not configured here: it lives per centre in the database (setting_definitions
# + centre_settings) and managers change it on the Settings screen.

# Read cache: process memory plus Redis shared across replicas. Booking
# decisions never read from it. Set CACHE_REDIS=false to use memory only.
CACHE_REDIS=true
CACHE_CONFIG_SECONDS=300
CACHE_STAFF_SECONDS=60
CACHE_BOARD_SECONDS=2
CACHE_ANALYTICS_SECONDS=15
CACHE_COMPARISON_SECONDS=60
CACHE_MEMORY_ENTRIES=1000
# Failed sign-ins allowed per client address within the window (counted in Redis when available)
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_MIN=10
