{
  "name": "turnwise",
  "version": "0.1.0",
  "private": true,
  "description": "Turnwise — live capacity and disruption coordination for diagnostic centres. Smarter turns. Smoother operations.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "setup": "npm run migrate && npm run seed",
    "dev": "concurrently -k -n api,worker,web -c cyan,magenta,green \"npm run dev -w server\" \"npm run worker -w server\" \"npm run dev -w web\"",
    "test": "npm test -w server",
    "lint": "eslint .",
    "loadtest": "npm run loadtest -w server --",
    "build": "npm run build -w web",
    "e2e": "playwright test",
    "start": "npm start -w server",
    "start:worker": "npm run start:worker -w server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0"
  }
}
